<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cab302assignment.SignInController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Sign In" styleClass="heading"/>

    <Label text="Email Address" styleClass="form-label"/>
    <TextField fx:id="emailField" promptText="Enter your email address">
        <tooltip><Tooltip text="The email you registered with"/></tooltip>
    </TextField>

    <Label text="Password" styleClass="form-label"/>
    <PasswordField fx:id="passwordField" promptText="Enter your password">
        <tooltip><Tooltip text="Your account password"/></tooltip>
    </PasswordField>

    <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

    <Button fx:id="signInButton" text="Sign In" onAction="#onSignIn" maxWidth="Infinity" disable="true"/>

    <Hyperlink text="Don't have an account? Sign up" onAction="#onGoToSignUp"/>
</VBox>
