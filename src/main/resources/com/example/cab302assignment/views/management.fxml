<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane style="-fx-background-color: #ffffff;"
            stylesheets="@../global.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cab302assignment.controller.ManagementController">
   <center>
      <ScrollPane fitToHeight="false" fitToWidth="true">
         <content>
            <!-- Outer padding wrapper -->
            <VBox alignment="TOP_CENTER" spacing="0">
               <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
                  <Label prefWidth="1170" alignment="CENTER" styleClass="h1" text="Organisation Management" />

                  <!-- Body -->
                  <HBox alignment="CENTER" maxWidth="1170" prefWidth="1170" spacing="20">
                     <VBox.margin><Insets top="10" /></VBox.margin>

                     <!-- Membership management card -->
                     <VBox prefHeight="690.0" prefWidth="670" spacing="40.0" HBox.hgrow="NEVER"
                           style="-fx-background-color: white; -fx-background-radius: 25;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 5, 5);" >
                        <padding><Insets bottom="28.0" left="60.0" right="60.0" top="80.0" /></padding>

                        <!-- Search section -->
                        <VBox spacing="8">
                           <Label styleClass="h4" text="Add or remove user from Organisation:" />
                           <HBox spacing="10" alignment="CENTER_LEFT">
                              <TextField fx:id="searchTextField" onAction="#onSearch"
                                         prefHeight="50.0" prefWidth="400.0"
                                         promptText="Please enter user's email:"
                                         style="-fx-background-color: #d7e3ed; -fx-background-radius: 15;
                                         -fx-border-radius: 15; -fx-text-fill: rgba(0,0,0,0.6);
                                         -fx-font-size: 22px; -fx-padding: 0 0 0 20;">
                              </TextField>
                              <Button text="Search" onAction="#onSearch" prefHeight="50.0"
                                      style="-fx-background-color: #FFCA76; -fx-text-fill: #27548A; -fx-padding: 6 20 6 20;
                                      -fx-background-radius: 12; -fx-cursor: hand; -fx-font-size: 18px;"/>
                           </HBox>
                        <padding>
                           <Insets left="20.0" right="20.0" />
                        </padding>
                        </VBox>

                        <!-- User info grid -->
                        <GridPane alignment="CENTER" hgap="16" vgap="14">
                           <columnConstraints>
                              <ColumnConstraints minWidth="100.0" percentWidth="38.0" />
                              <ColumnConstraints minWidth="120.0" percentWidth="62.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="36" />
                              <RowConstraints minHeight="36" />
                              <RowConstraints minHeight="36" />
                              <RowConstraints minHeight="36" />
                           </rowConstraints>

                           <Label styleClass="h4" text="User ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                           <Text fx:id="userIdText" fill="#183b4ecc" styleClass="h4"
                                 text="12345678" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                           <Label styleClass="h4" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                           <Text fx:id="nameText" fill="#183b4ecc" styleClass="h4"
                                 text="First Last" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                           <Label styleClass="h4" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                           <Text fx:id="emailText" fill="#183b4ecc" styleClass="h4"
                                 text="MyEmail@example.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                           <Label styleClass="h4" text="Member status:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                           <Text fx:id="statusText" fill="#183b4ecc" styleClass="h4"
                                 text="Active" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <padding>
                           <Insets bottom="20.0" left="40.0" right="10.0" top="0.0" />
                        </padding>
                        </GridPane>

                        <!-- Confirm checkbox and action buttons (hidden until search result) -->
                        <StackPane alignment="CENTER">
                           <padding><Insets bottom="10" top="10" /></padding>
                           <VBox fx:id="removeGroup" alignment="CENTER"
                                 managed="false" spacing="10" visible="false" StackPane.alignment="CENTER">
                              <CheckBox fx:id="confirmCheckBox" onAction="#onCheckboxClicked"
                                        prefHeight="21.0" prefWidth="398.0" styleClass="h4"
                                        text="Confirm. Note: this action cannot be undone."
                                        textFill="#00000099" wrapText="true" style="-fx-font-size: 16px; -fx-padding: 0 0 0 15;">
                              </CheckBox>
                              <Button fx:id="removeButton" disable="true" onAction="#onRemove"
                                      prefHeight="57.0" prefWidth="408.0"
                                      style="-fx-background-color: #FF928A; -fx-font-size: 26px;
                                      -fx-background-radius: 15; -fx-border-radius: 15;"
                                      text="Remove user from Organisation" textFill="#183b4e" wrapText="true">
                              </Button>
                           </VBox>
                           <Button fx:id="addButton" managed="false" onAction="#onAdd"
                                   prefHeight="57.0" prefWidth="300.0"
                                   style="-fx-background-color: #FFCA76; -fx-font-size: 26px;
                                   -fx-background-radius: 15; -fx-border-radius: 15;"
                                   text="Add / Activate user" textFill="#183b4e" visible="false"
                                   wrapText="true" StackPane.alignment="BOTTOM_CENTER">
                           </Button>
                           <Text fx:id="warningText" fill="#ff948c" managed="false"
                                 text="You cannot modify your own membership."
                                 style="-fx-font-size: 27px;"
                                 visible="false" StackPane.alignment="CENTER">
                           </Text>
                        </StackPane>
                     <HBox.margin>
                        <Insets right="15.0" />
                     </HBox.margin>
                     </VBox>

                     <!-- Right panel -->
<!--                     <VBox prefHeight="690.0" prefWidth="480" spacing="20"-->
<!--                           style="-fx-background-color: #d7e3ed; -fx-background-radius: 25;" HBox.hgrow="NEVER">-->
<!--                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>-->

<!--                        <Region VBox.vgrow="ALWAYS" />-->
<!--                     </VBox>-->
                  </HBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
