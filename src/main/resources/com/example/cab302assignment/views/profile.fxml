<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cab302assignment.controller.ProfileController">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>

    <Label text="Profile" styleClass="h1"/>

    <Label text="Name"/>
    <TextField fx:id="nameField"/>

    <Label text="Email Address"/>
    <TextField fx:id="emailField"/>

    <Label text="New Password (leave blank to keep current)"/>
    <PasswordField fx:id="newPasswordField" promptText="At least 8 characters"/>

    <Label text="Confirm New Password"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"/>

    <HBox spacing="10">
        <Button text="Update Profile" onAction="#onUpdateProfile" styleClass="btn-primary"/>
        <Button text="Delete Account" onAction="#onDeleteAccount" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="statusLabel"/>
</VBox>
