<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302assignment.controller.ProfileController">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>

    <center>
        <VBox alignment="TOP_CENTER" fillWidth="false" spacing="12">

    <Label styleClass="h1" text="Profile" />

    <Label text="Name" />
    <TextField fx:id="nameField" maxWidth="420" prefWidth="420" />

    <Label text="Email Address" />
    <TextField fx:id="emailField" maxWidth="420" prefWidth="420" />

    <Label text="New Password (leave blank to keep current)" />
    <PasswordField fx:id="newPasswordField" maxWidth="420" prefWidth="420" promptText="At least 8 characters" />

    <Label text="Confirm New Password" />
    <PasswordField fx:id="confirmPasswordField" maxWidth="420" prefWidth="420" promptText="Re-enter password" />

    <HBox alignment="CENTER" maxWidth="420" prefWidth="420" spacing="10">
        <Button onAction="#onUpdateProfile" styleClass="btn-primary" text="Update Profile" />
        <Button onAction="#onDeleteAccount" styleClass="btn-secondary" text="Delete Account" />
    </HBox>

    <Label fx:id="statusLabel" />

    <Button fx:id="leaveOrgButton" maxWidth="420" onAction="#onLeaveOrganisation" prefWidth="420" styleClass="btn-secondary" text="Leave Organisation" visible="false" />
        </VBox>
    </center>
   <right>
       <VBox fx:id="scoreBox" alignment="BOTTOM_CENTER" prefHeight="295.0" prefWidth="189.0" spacing="12" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="risk-score-title" text="User risk level" />
            <StackPane prefHeight="140.0" prefWidth="185.0">
               <children>
                  <Circle fill="#d7e3ed" radius="58.0" stroke="WHITE" strokeType="INSIDE" />
                  <Label fx:id="userScore" styleClass="risk-score-value" text="No history">
                   <font>
                       <Font size="26.0" />
                   </font>
                  </Label>
               </children>
            </StackPane>
         </children>
      </VBox>
   </right>
</BorderPane>
