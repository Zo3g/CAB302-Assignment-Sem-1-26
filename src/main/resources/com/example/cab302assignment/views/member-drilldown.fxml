<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cab302assignment.controller.MemberDrilldownController"
      spacing="20"
      stylesheets="@../global.css">

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

    <HBox alignment="CENTER" spacing="20">

        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="memberNameLabel" styleClass="h1" text="Loading Name...">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
            <Label fx:id="memberEmailLabel" text="Loading Email..." style="-fx-text-fill: gray;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <VBox alignment="BOTTOM_CENTER" spacing="10">
            <Label text="Current Risk Score:" />
            <StackPane>
                <Circle fill="#d7e3ed" radius="45.0" stroke="WHITE" strokeType="INSIDE" />
                <Label fx:id="memberScoreLabel" style="-fx-font-weight: bold;" text="--">
                    <font>
                        <Font size="26.0" />
                    </font>
                </Label>
            </StackPane>
        </VBox>

    </HBox>

    <Separator />

    <Label text="Prompt History" styleClass="h1">
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date (UTC)" prefWidth="150" />
            <TableColumn fx:id="promptColumn" text="Scrubbed Prompt" prefWidth="400" />
            <TableColumn fx:id="riskColumn" text="Risk Level" prefWidth="100" />
            <TableColumn fx:id="scoreColumn" text="Score" prefWidth="100" />
            <TableColumn fx:id="detectionsColumn" text="Detections" prefWidth="100" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No prompts analysed yet."/>
        </placeholder>
    </TableView>

</VBox>