<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx/21.0.1"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.cab302assignment.controller.OrgRiskDashboardController"
          hgap="20" vgap="20"
          stylesheets="@../global.css">

   <padding>
      <Insets top="30" bottom="30" left="40" right="40"/>
   </padding>

   <columnConstraints>
      <ColumnConstraints percentWidth="50" /> <ColumnConstraints percentWidth="50" /> </columnConstraints>
   <rowConstraints>
      <RowConstraints percentHeight="50" /> <RowConstraints percentHeight="50" /> </rowConstraints>

   <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="TOP_LEFT" spacing="10">
      <Label text="Organisation Risk Dashboard" styleClass="h1"/>
      <Label text="space for other dashboard components" style="-fx-text-fill: gray;"/>
   </VBox>

   <TableView fx:id="employeeTable" GridPane.columnIndex="1" GridPane.rowIndex="0">
      <columns>
         <TableColumn fx:id="nameColumn" text="Employee Name" />
         <TableColumn fx:id="scoreColumn" text="Risk Score" />
      </columns>

      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>

      <placeholder>
         <Label text="No employee data available."/>
      </placeholder>
   </TableView>

</GridPane>