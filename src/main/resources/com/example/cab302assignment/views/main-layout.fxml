<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="borderPane" stylesheets="@../sidebar.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302assignment.controller.SidebarController">
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="212.0" style="-fx-background-color: #F5EEDC;" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="75.0" fitWidth="175.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../../assets/images/guardia_logo.png" />
               </image>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin></ImageView>
            <Separator prefWidth="200.0" />
            <Button fx:id="managerDashboardButton" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#managerDashboard" prefHeight="41.0" prefWidth="218.0" styleClass="sidebar-nav-button" text="Dashboard">
               <graphic>
                  <FontIcon iconLiteral="fth-pie-chart" iconSize="12" />
               </graphic>
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="8.0" />
               </VBox.margin>
            </Button>
            <Separator prefWidth="200.0" />
            <Button fx:id="workspaceButton" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#workspace" prefHeight="41.0" prefWidth="216.0" styleClass="sidebar-nav-button" text="Workspace">
               <graphic>
                  <FontIcon iconLiteral="fth-message-square" iconSize="12" />
               </graphic>
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="8.0" />
               </VBox.margin>
            </Button>
            <Separator prefWidth="200.0" />
            <Button fx:id="profileButton" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#profile" prefHeight="41.0" prefWidth="216.0" styleClass="sidebar-nav-button" text="Profile">
               <graphic>
                  <FontIcon iconLiteral="fth-user" iconSize="12" />
               </graphic>
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="8.0" />
               </VBox.margin>
            </Button>
            <Separator prefWidth="200.0" />
            <Button fx:id="managementButton" alignment="BASELINE_LEFT" graphicTextGap="12.0" mnemonicParsing="false" onAction="#management" prefHeight="41.0" prefWidth="219.0" styleClass="sidebar-nav-button" text="Management">
               <graphic>
                  <FontIcon iconLiteral="fth-edit" iconSize="12" />
               </graphic>
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets left="8.0" />
               </VBox.margin>
            </Button>
            <Region prefHeight="122.0" prefWidth="184.0" VBox.vgrow="ALWAYS" />
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-account">
               <padding>
                  <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
               </padding>
               <FontIcon iconLiteral="fth-user" iconSize="18" />
               <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                  <Label fx:id="accountNameLabel" styleClass="sidebar-account-name" text="Signed out" />
                  <Label fx:id="accountEmailLabel" styleClass="sidebar-account-email" text="" />
               </VBox>
            </HBox>
            <Button fx:id="logOutButton" alignment="CENTER" mnemonicParsing="false" onAction="#onLogout" prefHeight="30.0" prefWidth="99.0" style="-fx-background-color: FFFFFF;" text="Log out">
               <graphic>
                  <FontIcon iconLiteral="fth-log-out" />
               </graphic>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
